<Window x:Class="PetPing.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PetPing — your reminder companion" Height="735" Width="910"
        MinHeight="620" MinWidth="720" Background="{StaticResource BackgroundBrush}"
        UseLayoutRounding="True" PreviewKeyDown="OnDashboardKeyDown"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,1,0,20">
      <StackPanel>
        <TextBlock Text="PetPing" FontSize="30" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/>
        <TextBlock Text="A little friend who remembers the important stuff." FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="1,5,0,0"/>
      </StackPanel>
      <Border Background="#FFEBDD" CornerRadius="13" Padding="12,8" HorizontalAlignment="Right" VerticalAlignment="Center">
        <TextBlock Text="●  Ready to remind you" Foreground="#8A6046" FontSize="12" FontWeight="SemiBold"/>
      </Border>
    </Grid>
    <Border Grid.Row="1" Background="White" CornerRadius="18" Padding="19" Margin="0,0,0,18" BorderBrush="#ECE8E2" BorderThickness="1">
      <StackPanel>
        <TextBlock Text="Create a reminder" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
        <TextBlock Text="What should your pet remind you about?" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,12"/>
        <TextBox x:Name="ReminderName" FontSize="15" MaxLength="120"
                 AutomationProperties.Name="Reminder name"
                 ToolTip="For example, Drink water or Start editing"/>
        <Grid Margin="0,13,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
            <TextBlock Text="Date" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/>
            <DatePicker x:Name="ReminderDate" Height="35" AutomationProperties.Name="Reminder date"/>
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,0">
            <TextBlock Text="Time (24h)" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/>
            <TextBox x:Name="ReminderTime" Text="19:00" FontSize="13"
                     AutomationProperties.Name="Reminder time in 24-hour format"/>
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="2">
            <TextBlock Text="Repeat" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/>
            <ComboBox x:Name="RepeatPicker" Height="35" SelectedIndex="0" FontSize="13"
                      AutomationProperties.Name="Repeat frequency"
                      ToolTip="Weekly repeats on the same weekday as the selected date">
              <ComboBoxItem Content="One time"/>
              <ComboBoxItem Content="Every day"/>
              <ComboBoxItem Content="Every week"/>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,13,0,0" Orientation="Horizontal"
                      HorizontalAlignment="Right">
            <Button x:Name="QuickAddButton" Content="In 1 minute" Click="OnQuickAdd" Background="#F2F1ED"/>
            <Button x:Name="CancelEditButton" Content="Cancel edit" Click="OnCancelEdit"
                    Visibility="Collapsed" Background="#F2F1ED"/>
            <Button x:Name="AddButton" Content="Add reminder" Click="OnAddReminder"
                    Background="{StaticResource AccentBrush}" Margin="0"/>
          </StackPanel>
        </Grid>
        <TextBlock x:Name="ValidationMessage" Foreground="#AF453D" FontSize="12" Margin="0,10,0,0" Visibility="Collapsed"/>
      </StackPanel>
    </Border>
    <Border Grid.Row="2" Background="White" CornerRadius="18" Padding="19" BorderBrush="#ECE8E2" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,11">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Your reminders" FontSize="17"
                     FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                     VerticalAlignment="Center" Margin="0,0,14,0"/>
          <ComboBox Grid.Column="1" x:Name="InboxPicker" Width="155" Height="32"
                    HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="12"
                    SelectionChanged="OnInboxChanged"
                    AutomationProperties.Name="Reminder list filter"
                    ToolTip="Choose which reminders to show">
            <ComboBoxItem Content="All reminders"/>
            <ComboBoxItem Content="Today"/>
            <ComboBoxItem Content="Upcoming"/>
            <ComboBoxItem Content="Needs attention"/>
            <ComboBoxItem Content="History"/>
          </ComboBox>
          <TextBlock Grid.Column="2" x:Name="ReminderCount" VerticalAlignment="Center"
                     Foreground="{StaticResource MutedBrush}" FontSize="12"/>
        </Grid>
        <TextBlock Grid.Row="1" x:Name="AttentionHint" TextWrapping="Wrap" Margin="0,0,0,9" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
        <Grid Grid.Row="2">
          <ListBox x:Name="ReminderList" BorderThickness="0" Background="Transparent"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionMode="Single"
                   AutomationProperties.Name="Reminders">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border CornerRadius="10" Background="#FAF9F7" Padding="12" Margin="0,2,0,7">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="#292D32" TextWrapping="Wrap"/>
                  <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="{Binding DueLabel}" FontSize="11" Foreground="#717782"/>
                    <TextBlock Text="  •  " FontSize="11" Foreground="#A4A6A8"/>
                    <TextBlock Text="{Binding StatusLabel}" FontSize="11" Foreground="#AF7352"/>
                    <TextBlock Text="   •   " FontSize="11" Foreground="#A4A6A8"/>
                    <TextBlock Text="{Binding RepeatLabel}" FontSize="11" Foreground="#717782"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel x:Name="EmptyInbox" VerticalAlignment="Center" HorizontalAlignment="Center"
                      Margin="16" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock Text="All clear for now" FontSize="17" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Foreground="{StaticResource InkBrush}"/>
            <TextBlock x:Name="EmptyInboxHint" Text="Your reminders will appear here."
                       TextWrapping="Wrap" Width="300" TextAlignment="Center"
                       HorizontalAlignment="Center" Margin="0,8,0,0"
                       FontSize="12" Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>
        </Grid>
        <WrapPanel Grid.Row="3" Margin="0,12,0,0" Orientation="Horizontal"
                   HorizontalAlignment="Left" ItemHeight="38">
          <Button Content="Edit" Background="#FFE5D3" Click="OnSelectedEdit"
                  AutomationProperties.Name="Edit selected reminder"/>
          <Button Content="Done" Background="#F1F0ED" Click="OnSelectedDone"
                  AutomationProperties.Name="Mark selected reminder complete"/>
          <Button Content="Snooze 10m" Background="#FFE5D3" Click="OnSelectedSnooze"
                  AutomationProperties.Name="Snooze selected reminder ten minutes"/>
          <Button Content="Delete" Background="#F1F0ED" Click="OnDelete"
                  AutomationProperties.Name="Delete selected reminder"/>
          <Button Content="Test pet" Click="OnTestPet" Background="#FFE5D3"
                  AutomationProperties.Name="Preview the pet reminder"/>
        </WrapPanel>
      </Grid>
    </Border>
    <StackPanel Grid.Row="3" Margin="0,15,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <CheckBox x:Name="StartupToggle" Content="Start with Windows" Margin="0,0,22,0" Click="OnStartupToggled" VerticalAlignment="Center"/>
        <CheckBox x:Name="VoiceToggle" Content="Speak reminders" Click="OnVoiceToggled" VerticalAlignment="Center"/>
        <Button Content="Test voice" Click="OnTestVoice" Background="#F1F0ED"
                MinHeight="26" Padding="9,4" Margin="10,0,0,0"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
        <TextBlock Text="Pet appears" Foreground="{StaticResource MutedBrush}" FontSize="12"
                   VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="PlacementPicker" Width="124" Height="29" FontSize="12"
                  SelectionChanged="OnAppearanceChanged" Margin="0,0,18,0">
          <ComboBoxItem Content="Auto"/>
          <ComboBoxItem Content="Top right"/>
          <ComboBoxItem Content="Bottom right"/>
          <ComboBoxItem Content="Top left"/>
          <ComboBoxItem Content="Bottom left"/>
        </ComboBox>
        <TextBlock Text="Motion" Foreground="{StaticResource MutedBrush}" FontSize="12"
                   VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="MotionPicker" Width="105" Height="29" FontSize="12"
                  SelectionChanged="OnAppearanceChanged">
          <ComboBoxItem Content="Playful"/>
          <ComboBoxItem Content="Gentle"/>
          <ComboBoxItem Content="Off"/>
        </ComboBox>
      </StackPanel>
      <TextBlock Text="Pet settings apply to the next reminder or pet preview." HorizontalAlignment="Right"
                 Margin="0,7,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,9,0,0">
        <TextBlock Text="Your reminders stay on this computer."
                   VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                   Margin="0,0,10,0" FontSize="11"/>
        <Button Content="Open data and diagnostics folder" Click="OnOpenDataFolder"
                Background="#F2F1ED" Padding="12,5" MinHeight="27"
                AutomationProperties.Name="Open local reminder data and diagnostics folder"
                ToolTip="Opens LocalAppData PetPing — includes reminders, backup files and diagnostics"/>
      </StackPanel>
      <TextBlock Text="Closing keeps reminders running in the tray. Quit from the tray to stop them."
                 Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
    </StackPanel>
  </Grid>
</Window>
