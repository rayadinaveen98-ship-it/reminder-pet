<Window x:Class="PetPing.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PetPing.Windows"
        Title="PetPing — Your desktop companion"
        Width="1100" Height="780" MinWidth="810" MinHeight="640"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI" UseLayoutRounding="True"
        PreviewKeyDown="OnDashboardKeyDown" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="218"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Persistent, quiet desktop navigation. -->
    <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="17,25,17,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="7,0,0,32">
          <TextBlock Text="● PetPing" FontSize="25" FontWeight="Bold"
                     Foreground="{StaticResource InkBrush}"/>
          <TextBlock Text="A companion for your day" FontSize="11"
                     Foreground="{StaticResource MutedBrush}" Margin="3,6,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
          <TextBlock Text="YOUR SPACE" FontSize="10"
                     Foreground="{StaticResource MutedBrush}" Margin="14,0,0,12"/>
          <Button x:Name="NavHome" Style="{StaticResource SideNavigationButton}"
                  Content="⌂   Home" Click="OnNavigateHome"
                  AutomationProperties.Name="Home dashboard"/>
          <Button x:Name="NavReminders" Style="{StaticResource SideNavigationButton}"
                  Content="◷   Reminders" Click="OnNavigateReminders"
                  AutomationProperties.Name="Reminders"/>
          <Button x:Name="NavPets" Style="{StaticResource SideNavigationButton}"
                  Content="♡   My Pets" Click="OnNavigatePets"
                  AutomationProperties.Name="My Pets"/>
          <Button x:Name="NavStudio" Style="{StaticResource SideNavigationButton}"
                  Content="✦   Pet Studio" Click="OnNavigateStudio"
                  AutomationProperties.Name="Pet Studio"/>
          <Button x:Name="NavSettings" Style="{StaticResource SideNavigationButton}"
                  Content="⚙   Settings" Click="OnNavigateSettings"
                  AutomationProperties.Name="Settings"/>
        </StackPanel>
        <Border Grid.Row="3" Background="#FFFFFF" CornerRadius="13"
                Padding="13" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
          <StackPanel>
            <TextBlock Text="●  Always close by" FontWeight="SemiBold"
                       FontSize="12" Foreground="#4A826D"/>
            <TextBlock Text="Closing this window keeps your reminders running in the tray."
                       Style="{StaticResource SecondaryBody}" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="76"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Background="#FCFBF9"
              BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="29,12,29,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="PageHeading" Text="Home" FontSize="21"
                       FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
            <TextBlock x:Name="PageDescription" Text="Your companion and today's plans."
                       FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
          </StackPanel>
          <Border Grid.Column="1" Background="#E9F5EE" CornerRadius="18"
                  Padding="13,7" VerticalAlignment="Center">
            <TextBlock Text="●  Ready to remind" FontSize="11"
                       FontWeight="SemiBold" Foreground="#39785C"/>
          </Border>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
        <Grid Margin="27,25,27,30">

          <!-- HOME: real store-driven counts, upcoming reminders and companion preview. -->
          <StackPanel x:Name="HomePage" Visibility="Visible">
            <Border CornerRadius="22" Background="#ECE6FB" Padding="25" Margin="0,0,0,18">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="178"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="A little help goes a long way." FontSize="23"
                             FontWeight="Bold" TextWrapping="Wrap"
                             Foreground="#332C56"/>
                  <TextBlock Text="Your companion is here to keep you on track, one reminder at a time."
                             TextWrapping="Wrap" FontSize="13" Foreground="#61577C"
                             Margin="0,10,9,16"/>
                  <WrapPanel>
                    <Button Content="+ Add reminder" Background="{StaticResource AccentBrush}"
                            Foreground="White" BorderBrush="#8575DD"
                            Click="OnHomeAdd" AutomationProperties.Name="Create a reminder"/>
                    <Button x:Name="HomeHelloButton" Content="Say hello to Milo" Click="OnTestPet"
                            Background="White" BorderBrush="#E1D9EF"/>
                  </WrapPanel>
                </StackPanel>
                <Viewbox Grid.Column="1" Width="150" Height="184" Stretch="Uniform"
                           HorizontalAlignment="Right" VerticalAlignment="Center">
                  <local:PetCharacter x:Name="HomeCharacter"/>
                </Viewbox>
              </Grid>
            </Border>

            <UniformGrid Columns="3" Margin="0,0,0,18">
              <Border Style="{StaticResource SoftCard}" Margin="0,0,10,0">
                <StackPanel>
                  <TextBlock Text="TODAY" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                  <TextBlock x:Name="HomeTodayCount" Text="0" FontSize="30"
                             FontWeight="Bold" Foreground="#3F3A52" Margin="0,5,0,1"/>
                  <TextBlock Text="On your schedule" Style="{StaticResource SecondaryBody}"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SoftCard}" Margin="0,0,10,0">
                <StackPanel>
                  <TextBlock Text="UPCOMING" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                  <TextBlock x:Name="HomeUpcomingCount" Text="0" FontSize="30"
                             FontWeight="Bold" Foreground="#3F3A52" Margin="0,5,0,1"/>
                  <TextBlock Text="Still to come" Style="{StaticResource SecondaryBody}"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SoftCard}">
                <StackPanel>
                  <TextBlock Text="NEEDS ATTENTION" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                  <TextBlock x:Name="HomeAttentionCount" Text="0" FontSize="30"
                             FontWeight="Bold" Foreground="#BC744D" Margin="0,5,0,1"/>
                  <TextBlock Text="Ready for your reply" Style="{StaticResource SecondaryBody}"/>
                </StackPanel>
              </Border>
            </UniformGrid>

            <Border Style="{StaticResource SoftCard}">
              <StackPanel>
                <DockPanel Margin="0,0,0,13">
                  <Button DockPanel.Dock="Right" Content="See all reminders →"
                          Click="OnNavigateReminders" Background="#EAE5FB"
                          HorizontalAlignment="Right"/>
                  <TextBlock Text="Coming up" Style="{StaticResource SectionHeading}"
                             VerticalAlignment="Center"/>
                </DockPanel>
                <ListBox x:Name="HomeNextList" Height="192" BorderThickness="0"
                         Background="Transparent" IsHitTestVisible="False"
                         AutomationProperties.Name="Next upcoming reminders">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border Background="#FAF8F5" CornerRadius="12" Padding="12"
                              Margin="0,0,0,7">
                        <StackPanel>
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                     Foreground="{StaticResource InkBrush}" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding DueLabel}" Margin="0,5,0,0"
                                     Style="{StaticResource SecondaryBody}"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="HomeEmptyNext" Text="All clear! Add a reminder when you're ready."
                           Visibility="Collapsed" Style="{StaticResource SecondaryBody}"
                           HorizontalAlignment="Center" Margin="0,6,0,12"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- REMINDERS: retained functional date/time/repeat editor and state actions. -->
          <StackPanel x:Name="RemindersPage" Visibility="Collapsed">
            <Border Style="{StaticResource SoftCard}" Margin="0,0,0,18">
              <StackPanel>
                <TextBlock Text="Make a little plan" Style="{StaticResource SectionHeading}"/>
                <TextBlock Text="What should Milo remind you about?"
                           Style="{StaticResource SecondaryBody}" Margin="0,5,0,14"/>
                <TextBox x:Name="ReminderName" MaxLength="120" FontSize="14"
                         AutomationProperties.Name="Reminder name"
                         ToolTip="For example: Start editing my video"/>
                <Grid Margin="0,14,0,0">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Date" Style="{StaticResource SecondaryBody}" Margin="0,0,0,5"/>
                    <DatePicker x:Name="ReminderDate" Height="38"
                                AutomationProperties.Name="Reminder date"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Time (24h)" Style="{StaticResource SecondaryBody}" Margin="0,0,0,5"/>
                    <TextBox x:Name="ReminderTime" Text="19:00"
                             AutomationProperties.Name="Reminder time in 24-hour format"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Repeat" Style="{StaticResource SecondaryBody}" Margin="0,0,0,5"/>
                    <ComboBox x:Name="RepeatPicker" Height="38" FontSize="13" SelectedIndex="0"
                              AutomationProperties.Name="Repeat frequency">
                      <ComboBoxItem Content="One time"/>
                      <ComboBoxItem Content="Every day"/>
                      <ComboBoxItem Content="Every week"/>
                    </ComboBox>
                  </StackPanel>
                  <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" HorizontalAlignment="Right"
                             Margin="0,16,0,0">
                    <Button x:Name="QuickAddButton" Content="In 1 minute"
                            Click="OnQuickAdd"/>
                    <Button x:Name="CancelEditButton" Content="Cancel edit"
                            Click="OnCancelEdit" Visibility="Collapsed"/>
                    <Button x:Name="AddButton" Content="Add reminder"
                            Background="{StaticResource AccentBrush}" Foreground="White"
                            Click="OnAddReminder"/>
                  </WrapPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource SoftCard}">
              <StackPanel>
                <DockPanel LastChildFill="False" Margin="0,0,0,12">
                  <TextBlock Text="Your reminders" Style="{StaticResource SectionHeading}"
                             DockPanel.Dock="Left" VerticalAlignment="Center"/>
                  <ComboBox x:Name="InboxPicker" DockPanel.Dock="Right" Width="172"
                            Height="34" SelectedIndex="0" SelectionChanged="OnInboxChanged"
                            AutomationProperties.Name="Reminder list filter">
                    <ComboBoxItem Content="All reminders"/>
                    <ComboBoxItem Content="Today"/>
                    <ComboBoxItem Content="Upcoming"/>
                    <ComboBoxItem Content="Needs attention"/>
                    <ComboBoxItem Content="History"/>
                  </ComboBox>
                </DockPanel>
                <TextBlock x:Name="ReminderCount" Style="{StaticResource SecondaryBody}"/>
                <TextBlock x:Name="AttentionHint" Style="{StaticResource SecondaryBody}"
                           Margin="0,4,0,12"/>
                <Grid>
                  <ListBox x:Name="ReminderList" Height="295" BorderThickness="0"
                           Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto"
                           SelectionMode="Single" AutomationProperties.Name="Reminders">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border CornerRadius="12" Background="#FAF9F7"
                                Padding="13" Margin="0,2,0,6">
                          <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                       FontSize="14" Foreground="{StaticResource InkBrush}"
                                       TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,5,0,0">
                              <TextBlock Text="{Binding DueLabel}" Style="{StaticResource SecondaryBody}"/>
                              <TextBlock Text="  •  " Style="{StaticResource SecondaryBody}"/>
                              <TextBlock Text="{Binding StatusLabel}" FontSize="12" Foreground="#A76745"/>
                              <TextBlock Text="  •  " Style="{StaticResource SecondaryBody}"/>
                              <TextBlock Text="{Binding RepeatLabel}" Style="{StaticResource SecondaryBody}"/>
                            </WrapPanel>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <StackPanel x:Name="EmptyInbox" VerticalAlignment="Center"
                              HorizontalAlignment="Center" Visibility="Collapsed"
                              IsHitTestVisible="False">
                    <TextBlock Text="All clear for now" FontSize="17"
                               HorizontalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock x:Name="EmptyInboxHint" Style="{StaticResource SecondaryBody}"
                               TextAlignment="Center" Width="280" Margin="0,8,0,0"/>
                  </StackPanel>
                </Grid>
                <WrapPanel Margin="0,14,0,0">
                  <Button Content="Edit" Click="OnSelectedEdit"
                          AutomationProperties.Name="Edit selected reminder"/>
                  <Button Content="Done" Click="OnSelectedDone"
                          AutomationProperties.Name="Mark selected reminder complete"/>
                  <Button Content="Snooze 10m" Click="OnSelectedSnooze"
                          AutomationProperties.Name="Snooze selected reminder ten minutes"/>
                  <Button Content="Delete" Click="OnDelete"
                          AutomationProperties.Name="Delete selected reminder"/>
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Three selectable and genuinely distinct WPF vector companions. -->
          <StackPanel x:Name="PetsPage" Visibility="Collapsed">
            <TextBlock Text="Choose your little companion" Style="{StaticResource SectionHeading}"/>
            <TextBlock Text="A cat, a puppy or a bunny — every choice changes the actual walking reminder."
                       Style="{StaticResource SecondaryBody}" Margin="0,7,0,19"/>
            <UniformGrid Columns="3" Margin="0,0,0,15">
              <Border Style="{StaticResource SoftCard}" Margin="0,0,7,0">
                <StackPanel>
                  <Viewbox Width="132" Height="180" Stretch="Uniform" HorizontalAlignment="Center">
                    <local:PetCharacter x:Name="PetsCatCharacter"/>
                  </Viewbox>
                  <TextBlock Text="Milo" FontSize="18" FontWeight="SemiBold" Margin="0,9,0,3"/>
                  <TextBlock Text="The curious cat" Style="{StaticResource SecondaryBody}"/>
                  <TextBlock x:Name="CatChoiceStatus" Text="Active" FontSize="11"
                             Foreground="#5B806B" Margin="0,7,0,10"/>
                  <Button x:Name="CatSelectButton" Content="Choose Milo"
                          Click="OnSelectCat" Background="#EDE7FB"
                          AutomationProperties.Name="Choose Milo the cat"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SoftCard}" Margin="7,0,7,0">
                <StackPanel>
                  <Viewbox Width="132" Height="180" Stretch="Uniform" HorizontalAlignment="Center">
                    <local:PetCharacter x:Name="PetsDogCharacter"/>
                  </Viewbox>
                  <TextBlock Text="Buddy" FontSize="18" FontWeight="SemiBold" Margin="0,9,0,3"/>
                  <TextBlock Text="The friendly puppy" Style="{StaticResource SecondaryBody}"/>
                  <TextBlock x:Name="DogChoiceStatus" Text="Available" FontSize="11"
                             Foreground="#7C709D" Margin="0,7,0,10"/>
                  <Button x:Name="DogSelectButton" Content="Choose Buddy"
                          Click="OnSelectDog" Background="#EDE7FB"
                          AutomationProperties.Name="Choose Buddy the dog"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SoftCard}" Margin="7,0,0,0">
                <StackPanel>
                  <Viewbox Width="132" Height="180" Stretch="Uniform" HorizontalAlignment="Center">
                    <local:PetCharacter x:Name="PetsBunnyCharacter"/>
                  </Viewbox>
                  <TextBlock Text="Luna" FontSize="18" FontWeight="SemiBold" Margin="0,9,0,3"/>
                  <TextBlock Text="The lively bunny" Style="{StaticResource SecondaryBody}"/>
                  <TextBlock x:Name="BunnyChoiceStatus" Text="Available" FontSize="11"
                             Foreground="#7C709D" Margin="0,7,0,10"/>
                  <Button x:Name="BunnySelectButton" Content="Choose Luna"
                          Click="OnSelectBunny" Background="#EDE7FB"
                          AutomationProperties.Name="Choose Luna the bunny"/>
                </StackPanel>
              </Border>
            </UniformGrid>
            <Border Style="{StaticResource SoftCard}">
              <StackPanel>
                <TextBlock x:Name="ActivePetDescription" Style="{StaticResource SecondaryBody}"
                           Text="Your selection is saved on this computer."/>
                <WrapPanel Margin="0,13,0,0">
                  <Button Content="Preview active pet" Click="OnTestPet" Background="#EDE7FB"/>
                  <Button Content="Customize in Pet Studio" Click="OnNavigateStudio"/>
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Real saved pet profile controls, not inert mockup selectors. -->
          <StackPanel x:Name="StudioPage" Visibility="Collapsed">
            <Border Style="{StaticResource SoftCard}" Margin="0,0,0,17">
              <StackPanel>
                <TextBlock x:Name="StudioTitle" Text="Make Milo your own" Style="{StaticResource SectionHeading}"/>
                <TextBlock Text="Your changes save automatically and apply to the next reminder."
                           Style="{StaticResource SecondaryBody}" Margin="0,5,0,13"/>
                <Border CornerRadius="19" Background="#F5EAF4" Padding="12" Margin="0,0,0,13">
                  <Viewbox Width="188" Height="214" Stretch="Uniform" HorizontalAlignment="Center">
                    <local:PetCharacter x:Name="StudioCharacter"/>
                  </Viewbox>
                </Border>
                <WrapPanel HorizontalAlignment="Center">
                  <Button Content="Preview on desktop" Click="OnTestPet"
                          Background="{StaticResource AccentBrush}" Foreground="White"/>
                  <Button Content="Choose another pet" Click="OnNavigatePets"/>
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource SoftCard}" Margin="0,0,0,17">
              <StackPanel>
                <TextBlock Text="Appearance" Style="{StaticResource SectionHeading}"/>
                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Coat color" Style="{StaticResource SecondaryBody}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="PetPalettePicker" Height="38" SelectionChanged="OnPetProfileChanged"
                              AutomationProperties.Name="Pet color">
                      <ComboBoxItem Content="Apricot"/><ComboBoxItem Content="Cocoa"/>
                      <ComboBoxItem Content="Snow"/><ComboBoxItem Content="Lavender"/>
                    </ComboBox>
                    <TextBlock Text="Accessory" Style="{StaticResource SecondaryBody}" Margin="0,13,0,6"/>
                    <ComboBox x:Name="PetAccessoryPicker" Height="38" SelectionChanged="OnPetProfileChanged"
                              AutomationProperties.Name="Pet accessory">
                      <ComboBoxItem Content="None"/><ComboBoxItem Content="Bow"/>
                      <ComboBoxItem Content="Scarf"/>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="Pet size" Style="{StaticResource SecondaryBody}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="PetSizePicker" Height="38" SelectionChanged="OnPetProfileChanged"
                              AutomationProperties.Name="Pet size">
                      <ComboBoxItem Content="Small"/><ComboBoxItem Content="Medium"/>
                      <ComboBoxItem Content="Large"/>
                    </ComboBox>
                    <TextBlock Text="Personality" Style="{StaticResource SecondaryBody}" Margin="0,13,0,6"/>
                    <ComboBox x:Name="PetPersonalityPicker" Height="38"
                              SelectionChanged="OnPetProfileChanged"
                              AutomationProperties.Name="Pet movement personality">
                      <ComboBoxItem Content="Playful"/><ComboBoxItem Content="Calm"/>
                      <ComboBoxItem Content="Curious"/>
                    </ComboBox>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource SoftCard}" Margin="0,0,0,17">
              <StackPanel>
                <TextBlock Text="Actions and voice" Style="{StaticResource SectionHeading}"/>
                <TextBlock Text="Pick what your pet does when you finish or postpone a reminder."
                           Style="{StaticResource SecondaryBody}" Margin="0,5,0,13"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="When I say Done" Style="{StaticResource SecondaryBody}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="PetDonePicker" Height="38" SelectionChanged="OnPetProfileChanged">
                      <ComboBoxItem Content="Happy hop"/><ComboBoxItem Content="Little wave"/>
                    </ComboBox>
                    <TextBlock Text="When I say Snooze" Style="{StaticResource SecondaryBody}" Margin="0,13,0,6"/>
                    <ComboBox x:Name="PetSnoozePicker" Height="38" SelectionChanged="OnPetProfileChanged">
                      <ComboBoxItem Content="Sleepy yawn"/><ComboBoxItem Content="Gentle stretch"/>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="Repeat spoken reminder" Style="{StaticResource SecondaryBody}"
                               Margin="0,0,0,6"/>
                    <ComboBox x:Name="PetRepeatPicker" Height="38" SelectionChanged="OnPetProfileChanged"
                              AutomationProperties.Name="Time between spoken reminders">
                      <ComboBoxItem Content="30 seconds"/><ComboBoxItem Content="60 seconds"/>
                      <ComboBoxItem Content="120 seconds"/>
                    </ComboBox>
                    <TextBlock Text="Voice repeats after each announcement finishes, until you respond or mute it."
                               Style="{StaticResource SecondaryBody}" Margin="0,10,0,0"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource SoftCard}">
              <StackPanel>
                <TextBlock Text="Arrival and motion" Style="{StaticResource SectionHeading}"/>
                <TextBlock Text="These preferences also apply to the next pet reminder."
                           Style="{StaticResource SecondaryBody}" Margin="0,5,0,14"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Arrival side" Style="{StaticResource SecondaryBody}" Margin="0,0,0,7"/>
                    <ComboBox x:Name="PlacementPicker" Height="38" SelectionChanged="OnAppearanceChanged">
                      <ComboBoxItem Content="Random left or right"/>
                      <ComboBoxItem Content="Top right"/>
                      <ComboBoxItem Content="Bottom right"/>
                      <ComboBoxItem Content="Top left"/>
                      <ComboBoxItem Content="Bottom left"/>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="Motion" Style="{StaticResource SecondaryBody}" Margin="0,0,0,7"/>
                    <ComboBox x:Name="MotionPicker" Height="38" SelectionChanged="OnAppearanceChanged">
                      <ComboBoxItem Content="Playful"/><ComboBoxItem Content="Gentle"/>
                      <ComboBoxItem Content="Off"/>
                    </ComboBox>
                  </StackPanel>
                </Grid>
                <TextBlock Text="Motion Off removes walking and animated reactions."
                           Style="{StaticResource SecondaryBody}" Margin="0,11,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>

                    <!-- SETTINGS: fully functional existing voice/startup and privacy controls. -->
          <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
            <Border Style="{StaticResource SoftCard}" Margin="0,0,0,17">
              <StackPanel>
                <TextBlock Text="Reminders and sound" Style="{StaticResource SectionHeading}"/>
                <TextBlock Text="Choose how PetPing keeps you informed."
                           Style="{StaticResource SecondaryBody}" Margin="0,6,0,17"/>
                <CheckBox x:Name="VoiceToggle" Content="Speak reminders out loud"
                          Click="OnVoiceToggled" FontSize="14" Margin="0,0,0,14"/>
                <Button Content="Test voice" Width="130" HorizontalAlignment="Left"
                        Click="OnTestVoice" Background="#EEE9FA"/>
                <TextBlock Text="Voice uses Windows speech on this computer."
                           Style="{StaticResource SecondaryBody}" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SoftCard}" Margin="0,0,0,17">
              <StackPanel>
                <TextBlock Text="Windows and startup" Style="{StaticResource SectionHeading}"/>
                <CheckBox x:Name="StartupToggle" Content="Start PetPing with Windows"
                          Click="OnStartupToggled" FontSize="14" Margin="0,15,0,0"/>
                <TextBlock Text="Closing the dashboard keeps reminders running quietly in the system tray."
                           Style="{StaticResource SecondaryBody}" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SoftCard}">
              <StackPanel>
                <TextBlock Text="Your data stays yours" Style="{StaticResource SectionHeading}"/>
                <TextBlock Text="Reminders, preferences and diagnostics are stored locally. You can open the folder to make a backup."
                           Style="{StaticResource SecondaryBody}" Margin="0,8,0,14"/>
                <Button Content="Open data and diagnostics folder" HorizontalAlignment="Left"
                        Click="OnOpenDataFolder" Background="#F2EEE8"
                        AutomationProperties.Name="Open local reminder data and diagnostics folder"/>
                <TextBlock Text="PetPing Windows preview • v0.12" FontSize="11"
                           Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <!-- Accessible errors stay visible regardless of the selected page. -->
      <Border Grid.Row="1" x:Name="ErrorToast" Visibility="Collapsed"
              VerticalAlignment="Bottom" HorizontalAlignment="Center"
              MaxWidth="560" Margin="16" Background="#FFF0E9" BorderBrush="#D6A298"
              BorderThickness="1" CornerRadius="11" Padding="13">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="×" Click="OnDismissError"
                  MinWidth="28" Padding="6,2" Margin="12,0,0,0"
                  AutomationProperties.Name="Dismiss error message"/>
          <TextBlock x:Name="ValidationMessage" Foreground="#9B403E"
                     TextWrapping="Wrap" VerticalAlignment="Center"
                     FontSize="12" AutomationProperties.LiveSetting="Assertive"/>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
