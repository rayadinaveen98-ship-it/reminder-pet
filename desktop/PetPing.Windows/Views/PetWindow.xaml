<Window x:Class="PetPing.Windows.Views.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PetPing — friendly reminder"
        Width="425" Height="236" MinWidth="425" MinHeight="236"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ShowActivated="False" SnapsToDevicePixels="True"
        MouseEnter="OnPetMouseEnter" MouseLeave="OnPetMouseLeave">
  <Window.Resources>
    <Style x:Key="BubbleAction" TargetType="{x:Type Button}">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="MinHeight" Value="27"/>
      <Setter Property="Padding" Value="11,5"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#4A3C32"/>
      <Setter Property="Background" Value="#F5F0EB"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}" CornerRadius="14"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.82"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.68"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.48"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <!-- A truly transparent stage: only the bubble and the free-standing pet have paint.
       No full-size white notification card behind the character. -->
  <Canvas x:Name="Stage" Width="425" Height="236">
    <Canvas.RenderTransform>
      <TranslateTransform x:Name="EntranceSlide" X="85"/>
    </Canvas.RenderTransform>
    <!-- Small speech bubble and pointer -->
    <Border Canvas.Left="12" Canvas.Top="27" Width="252" Height="151"
            Background="#FFFBF6" BorderBrush="#E8CBB4"
            BorderThickness="1.2" CornerRadius="19">
      <Border.Effect>
        <DropShadowEffect Color="#77513C" BlurRadius="14" ShadowDepth="3" Opacity="0.22"/>
      </Border.Effect>
      <Grid Margin="15,12,15,11">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <TextBlock Text="HEY, REMINDER TIME!" FontFamily="Segoe UI"
                     FontSize="10" FontWeight="Bold" Foreground="#C2764F"
                     VerticalAlignment="Center"/>
          <Button x:Name="HideButton" Content="×" HorizontalAlignment="Right"
                  Background="Transparent" BorderThickness="0" Width="24" Height="22"
                  FontSize="18" Foreground="#88776C" Cursor="Hand" Padding="0"
                  ToolTip="Hide for now — reminder stays in Needs Attention"
                  Click="OnHide" VerticalAlignment="Top"/>
        </Grid>
        <TextBlock Grid.Row="1" x:Name="ReminderTitle"
                   FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold"
                   Foreground="#332A27" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" MaxHeight="58" Margin="0,4,0,7"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal">
          <Button Style="{StaticResource BubbleAction}" Content="Snooze 10m"
                  Click="OnSnooze" Margin="0,0,8,0"/>
          <Button Style="{StaticResource BubbleAction}" Content="Done ✓"
                  Background="#F4B38D" Click="OnDone"/>
        </StackPanel>
      </Grid>
    </Border>
    <Polygon Canvas.Left="262" Canvas.Top="75" Points="0,0 17,10 0,22"
             Fill="#FFFBF6" Stroke="#E8CBB4" StrokeThickness="1"/>

    <!-- An original vector cat, physically separate from the speech bubble. -->
    <Canvas Canvas.Left="274" Canvas.Top="4" Width="145" Height="224"
            x:Name="PetBody" IsHitTestVisible="False">
      <Canvas.RenderTransform>
        <TranslateTransform x:Name="PetFloat"/>
      </Canvas.RenderTransform>
      <!-- tail (behind body): subtle ongoing wag -->
      <Path Data="M 112,157 C 157,156 154,105 128,112"
            Stroke="#E49C65" StrokeThickness="16" StrokeStartLineCap="Round"
            StrokeEndLineCap="Round" Fill="Transparent">
        <Path.RenderTransform>
          <RotateTransform x:Name="TailWag" CenterX="115" CenterY="152"/>
        </Path.RenderTransform>
      </Path>
      <!-- feet and legs -->
      <Ellipse Canvas.Left="39" Canvas.Top="181" Width="38" Height="22"
               Fill="#DE9463" Stroke="#A96F50" StrokeThickness="1.5"/>
      <Ellipse Canvas.Left="83" Canvas.Top="181" Width="38" Height="22"
               Fill="#DE9463" Stroke="#A96F50" StrokeThickness="1.5"/>
      <!-- body and cream chest -->
      <Ellipse Canvas.Left="30" Canvas.Top="102" Width="100" Height="94"
               Fill="#F1AD78" Stroke="#A96F50" StrokeThickness="2"/>
      <Ellipse Canvas.Left="58" Canvas.Top="125" Width="47" Height="63"
               Fill="#FFE0B8"/>
      <!-- pointed ears behind face -->
      <Polygon Points="31,66 33,13 68,41" Fill="#F1AD78"
               Stroke="#A96F50" StrokeThickness="2"/>
      <Polygon Points="93,41 129,13 131,67" Fill="#F1AD78"
               Stroke="#A96F50" StrokeThickness="2"/>
      <Polygon Points="40,53 41,28 59,46" Fill="#F8C3B2"/>
      <Polygon Points="104,46 122,27 122,54" Fill="#F8C3B2"/>
      <!-- head -->
      <Ellipse Canvas.Left="23" Canvas.Top="39" Width="116" Height="112"
               Fill="#F6B683" Stroke="#A96F50" StrokeThickness="2"/>
      <!-- face markings -->
      <Ellipse Canvas.Left="31" Canvas.Top="102" Width="21" Height="11"
               Fill="#EC9387" Opacity="0.6"/>
      <Ellipse Canvas.Left="109" Canvas.Top="102" Width="21" Height="11"
               Fill="#EC9387" Opacity="0.6"/>
      <Ellipse Canvas.Left="46" Canvas.Top="81" Width="9" Height="14" Fill="#473934">
        <Ellipse.RenderTransform><ScaleTransform x:Name="LeftBlink" CenterY="7"/></Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse Canvas.Left="108" Canvas.Top="81" Width="9" Height="14" Fill="#473934">
        <Ellipse.RenderTransform><ScaleTransform x:Name="RightBlink" CenterY="7"/></Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse Canvas.Left="47" Canvas.Top="83" Width="3" Height="4" Fill="#FFFFFF"/>
      <Ellipse Canvas.Left="109" Canvas.Top="83" Width="3" Height="4" Fill="#FFFFFF"/>
      <Ellipse Canvas.Left="76" Canvas.Top="107" Width="12" Height="8"
               Fill="#D97D73"/>
      <Path x:Name="MouthSmile"
            Data="M 82,115 Q 70,128 63,115 M 82,115 Q 91,128 100,115"
            Stroke="#985F50" StrokeThickness="2" StrokeStartLineCap="Round"
            Fill="Transparent"/>
      <!-- Talking mouth is synchronized to Windows speech start/finish,
           not guessed from the reminder text length. -->
      <Ellipse x:Name="MouthSpeak" Canvas.Left="76" Canvas.Top="116" Width="12"
               Height="11" Fill="#A45D51" Visibility="Collapsed"/>
      <!-- whiskers -->
      <Path Data="M 48,109 L 25,106 M 49,118 L 26,126 M 115,109 L 139,106 M 114,118 L 137,126"
            Stroke="#AB785E" StrokeThickness="1.5" Fill="Transparent"/>
      <!-- front paws -->
      <Ellipse Canvas.Left="45" Canvas.Top="155" Width="25" Height="37"
               Fill="#F8BD8F" Stroke="#A96F50" StrokeThickness="1.4"/>
      <Ellipse Canvas.Left="94" Canvas.Top="155" Width="25" Height="37"
               Fill="#F8BD8F" Stroke="#A96F50" StrokeThickness="1.4"/>
    </Canvas>
  </Canvas>
</Window>
