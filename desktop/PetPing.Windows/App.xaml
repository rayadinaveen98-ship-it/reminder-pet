<Application x:Class="PetPing.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F8F7F4"/>
    <SolidColorBrush x:Key="InkBrush" Color="#292D32"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#697079"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#EF976B"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="13,9"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="#FFE8DB"/>
      <Setter Property="Foreground" Value="#292D32"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="MinHeight" Value="35"/>
      <Setter Property="BorderBrush" Value="#E4E5E5"/>
      <Setter Property="Background" Value="White"/>
    </Style>
  </Application.Resources>
</Application>
