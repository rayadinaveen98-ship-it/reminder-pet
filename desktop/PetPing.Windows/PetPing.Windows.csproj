<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PetPing.Windows</AssemblyName>
    <Version>0.18.0</Version>
    <FileVersion>0.18.0.0</FileVersion>
    <InformationalVersion>0.18.0-experimental</InformationalVersion>
    <RootNamespace>PetPing.Windows</RootNamespace>
    <DefineConstants>$(DefineConstants);PETPING_EXPERIMENTAL</DefineConstants>
    <ApplicationIcon>Assets\PetPing.ico</ApplicationIcon>
  </PropertyGroup>
  <!-- Always regenerate from the selected WPF vector for IDE and CI builds. -->
  <Target Name="GenerateCompanionBeaconIco" BeforeTargets="PrepareForBuild"
          Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="powershell.exe -NoLogo -NoProfile -STA -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\tools\Build-BrandIcons.ps1&quot;" />
  </Target>
  <ItemGroup>
    <PackageReference Include="System.Speech" Version="10.0.13" />
  </ItemGroup>
</Project>
