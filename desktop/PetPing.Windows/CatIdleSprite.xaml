<UserControl x:Class="PetPing.Windows.CatIdleSprite"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="150" Height="218" Background="Transparent"
             IsHitTestVisible="False" Focusable="False">
  <Canvas Width="150" Height="218" ClipToBounds="False">
    <Image x:Name="CatFrame" Canvas.Left="-7" Canvas.Top="0"
           Width="164" Height="218" Stretch="Fill"
           RenderOptions.BitmapScalingMode="HighQuality"
           SnapsToDevicePixels="True" RenderTransformOrigin="0.5,1">
      <Image.RenderTransform>
        <TransformGroup>
          <ScaleTransform x:Name="BreathingScale" ScaleX="1" ScaleY="1"/>
          <TranslateTransform x:Name="IdleShift"/>
        </TransformGroup>
      </Image.RenderTransform>
    </Image>
  </Canvas>
</UserControl>